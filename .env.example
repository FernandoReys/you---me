# Vercel: required for persistent cloud data. Do not commit actual credentials.
DATABASE_URL=
# Direct connection, used only by npm run db:migrate (not browser/runtime).
DATABASE_URL_UNPOOLED=
# Optional relay for reliable audio/video across mobile and restrictive networks.
# Include TURN over TLS, port 443, for restrictive networks; comma-separated URLs.
TURN_URL=
# Prefer a coturn shared secret, which produces temporary per-user credentials.
TURN_SHARED_SECRET=
# Alternative: provider-issued TURN account credentials (never commit them).
TURN_USERNAME=
TURN_PASSWORD=
